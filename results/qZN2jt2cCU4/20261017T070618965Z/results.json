    },
    {
      "videoId": "qZN2jt2cCU4",
      "sentenceId": "s0015",
      "text": "In short, I know a lot about the Earth’s atmosphere and climate.",
      "start": 69.92,
      "end": 74.56,
      "screeningType": "score",
      "suspicionScore": 0.26,
      "reviewThreshold": 2,
