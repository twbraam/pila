      "suspicionScore": 2.37,
      "reviewThreshold": 2,
      "suspectedIssue": true,
      "nextStep": "verify_claim",
      "truthStatus": "not_assessed"
    },
    {
      "videoId": "3PWtaackIJU",
      "sentenceId": "s0007",
      "text": "We are often being told that we’re seeing more and more droughts, but a study published in March 2014 in the journal Nature actually shows a decrease in the world’s surface that has been afflicted by droughts since 1982.",
      "start": 46.22,
      "end": 59.660000000000004,
      "screeningType": "score",
      "suspicionScore": 2.03,
