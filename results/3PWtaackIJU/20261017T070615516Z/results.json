      "truthStatus": "not_assessed"
    },
    {
      "videoId": "3PWtaackIJU",
      "sentenceId": "s0009",
      "text": "Hurricanes are likewise used as an example of things getting worse.",
      "start": 67.85,
      "end": 72.00999999999999,
      "screeningType": "score",
      "suspicionScore": 0.15,
      "reviewThreshold": 2,
      "suspectedIssue": false,
