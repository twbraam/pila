    },
    {
      "videoId": "3PWtaackIJU",
      "sentenceId": "s0024",
      "text": "It is.",
      "start": 192.319,
      "end": 194.759,
      "screeningType": "score",
      "suspicionScore": 0.52,
      "reviewThreshold": 2,
      "suspectedIssue": false,
