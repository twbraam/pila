      "truthStatus": "not_assessed"
    },
    {
      "videoId": "3PWtaackIJU",
      "sentenceId": "s0008",
      "text": "Facts like these are important because a one-side focus on worst-case stories is a poor foundation for sound policies.",
      "start": 59.66,
      "end": 67.85,
      "screeningType": "score",
      "suspicionScore": 0.05,
      "reviewThreshold": 2,
      "suspectedIssue": false,
