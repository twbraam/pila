      "truthStatus": "not_assessed"
    },
    {
      "videoId": "3PWtaackIJU",
      "sentenceId": "s0019",
      "text": "The dramatic decline is mostly due to economic developments that help nations withstand catastrophes.",
      "start": 160.3,
