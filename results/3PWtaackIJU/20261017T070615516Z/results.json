      "truthStatus": "not_assessed"
    },
    {
      "videoId": "3PWtaackIJU",
      "sentenceId": "s0012",
      "text": "Yet the trend for strong typhoons around the Philippines have actually declined since 1950, according to a study published in 2012 by the Journal of Climate.",
      "start": 101.869,
      "end": 111.62,
      "screeningType": "score",
      "suspicionScore": 1.93,
      "reviewThreshold": 2,
      "suspectedIssue": false,
