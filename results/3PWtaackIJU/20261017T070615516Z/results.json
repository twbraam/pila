    },
    {
      "videoId": "3PWtaackIJU",
      "sentenceId": "s0018",
      "text": "Since then, the death rates have dropped 97% to a new low in the 2010s of less than 4 per million.",
      "start": 152.26,
      "end": 160.29999999999998,
      "screeningType": "score",
      "suspicionScore": 1.68,
      "reviewThreshold": 2,
      "suspectedIssue": false,
