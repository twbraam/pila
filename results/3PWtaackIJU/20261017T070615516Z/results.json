      "truthStatus": "not_assessed"
    },
    {
      "videoId": "3PWtaackIJU",
      "sentenceId": "s0010",
      "text": "But look at the U.S., where we have the best statistics: if we adjust for population and wealth, hurricane damage during the period of 1900-2013 actually decreased slightly.",
      "start": 72.01,
      "end": 84.14,
      "screeningType": "score",
      "suspicionScore": 1.75,
      "reviewThreshold": 2,
      "suspectedIssue": false,
