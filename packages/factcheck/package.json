{
  "name": "@pila/factcheck",
  "version": "0.1.0",
  "description": "Fact-check YouTube video transcripts with TypeSafe Jev and Tavily search",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "check-video": "tsx scripts/check-video.ts",
    "build:sw-test": "esbuild test/sw/entry.ts --bundle --format=esm --platform=browser --target=chrome120 --outfile=test/sw/extension/sw.js",
    "test:sw": "npm run build:sw-test && playwright test"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
